generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  USER
  ADMIN
}

enum Rank {
  BRONZE
  SILVER
  GOLD
  PLATINUM
  DIAMOND
}

model User {
  id           Int       @id @default(autoincrement())
  username     String    @unique
  name         String
  email        String    @unique
  password     String
  createdAt    DateTime  @default(now())
  role         Role      @default(USER)
  rank         Rank      @default(BRONZE)
  totalRentals Int       @default(0)
  sessions     Session[]
}

model Car {
  id           Int      @id @default(autoincrement())
  brand        String
  type         String
  model        String
  year         Int
  pricePerDay  Int
  seats        Int
  hp           Int
  transmission String
  fuelType     String
  image        String
  description  String?
  featured     Boolean  @default(false)
  color        String?
  mileage      Int?
  available    Boolean  @default(true)
  createdAt    DateTime @default(now())
}

model Messages {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  phone     String   @default("")
  type      String   @default("General Inquiry")
  message   String
  createdAt DateTime @default(now())
}

model Session {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
