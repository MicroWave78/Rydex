generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  USER
  ADMIN
}

enum Rank {
  BRONZE
  SILVER
  GOLD
  PLATINUM
  DIAMOND
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  name         String
  email        String   @unique
  password     String
  createdAt    DateTime @default(now())
  role         Role     @default(USER)
  rank         Rank     @default(BRONZE)
  totalRentals Int      @default(0)
}

model Car {
  id          Int      @id @default(autoincrement())
  model       String
  year        Int
  pricePerDay Int
  available   Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model Messages {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  phone     String   @default("")
  type      String   @default("General Inquiry")
  message   String
  createdAt DateTime @default(now())
}
