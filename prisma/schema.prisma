generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  USER
  ADMIN
}

enum Rank {
  BRONZE
  SILVER
  GOLD
  PLATINUM
  DIAMOND
  VIP
}

enum RentalStatus {
  PENDING
  CONFIRMED
  CANCELLED
  ACTIVE
  COMPLETED
}

enum MessageStatus {
  UNREAD
  READ
  REPLIED
  ARCHIVED
}

model User {
  id           Int       @id @default(autoincrement())
  username     String    @unique
  name         String
  email        String    @unique
  password     String
  createdAt    DateTime  @default(now())
  role         Role      @default(USER)
  rank         Rank      @default(BRONZE)
  active       Boolean   @default(true)
  totalRentals Int       @default(0)
  sessions     Session[]
  rentals      Rental[]
  reviews      Review[]
}

model Car {
  id           Int      @id @default(autoincrement())
  brand        String
  type         String
  model        String
  year         Int
  pricePerDay  Int
  seats        Int
  hp           Int
  transmission String
  fuelType     String
  image        String
  description  String?
  featured     Boolean  @default(false)
  color        String?
  mileage      Int?
  available    Boolean  @default(true)
  createdAt    DateTime @default(now())
  rentals      Rental[]
  reviews      Review[]
}

model Messages {
  id        Int           @id @default(autoincrement())
  name      String
  email     String
  phone     String        @default("")
  type      String        @default("General Inquiry")
  status    MessageStatus @default(UNREAD)
  message   String
  createdAt DateTime      @default(now())
}

model Session {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Rental {
  id             Int          @id @default(autoincrement())
  userId         Int
  carId          Int
  pickupDate     DateTime
  returnDate     DateTime
  pickupLocation String
  totalPrice     Int
  status         RentalStatus @default(CONFIRMED)
  createdAt      DateTime     @default(now())

  user User @relation(fields: [userId], references: [id])
  car  Car  @relation(fields: [carId], references: [id])
}

model Review {
  id Int @id @default(autoincrement())

  rating  Int
  comment String

  createdAt DateTime @default(now())

  userId Int
  user   User @relation(fields: [userId], references: [id])

  carId Int
  car   Car @relation(fields: [carId], references: [id])

  @@unique([userId, carId])
}
